# Configuration locale de developpement : copier ce fichier en ".env" (ignore par git).
# Lu par "npm run dev". En production, ces valeurs sont dans PortailTickets.xml (service Windows).

# Base PostgreSQL du portail
#  - avec le docker-compose du projet (docker compose up -d base) :
DATABASE_URL=postgres://portail:portail_demo@localhost:5432/portail

# Conteneur Docker a demarrer automatiquement (vide = base PostgreSQL deja lancee ailleurs)
DEV_CONTENEUR_PG=portail-tickets-base

# Nom de l'organisation affiche dans le bandeau (defaut en demo : "Groupe Exemple")
# ORGANISATION=Groupe Exemple

# Vraie instance EasyVista (SOURCE=easyvista, ou npm run explorer-ev) :
# URL sans /api/v1, numero de compte, jeton (Administration > Access Management > Access Tokens)
# EV_URL=https://mon-organisation.easyvista.com
# EV_ACCOUNT=50004
# EV_TOKEN=
# 1 = aucune ecriture envoyee a EV (exploration, essai avec un jeton personnel)
# EV_LECTURE_SEULE=1

# Port du portail
PORT=3000

# Base des tests PostgreSQL (npm test) : DEDIEE aux tests, videe a chaque execution
# (son nom doit contenir "test"). Creee automatiquement dans le meme PostgreSQL si
# l'utilisateur en a le droit (CREATEDB) ; sinon, la creer une fois en administrateur :
#   CREATE DATABASE portail_test OWNER portail;
TEST_DATABASE_URL=postgres://portail:portail_demo@localhost:5432/portail_test

# Demo : nombre de tickets generes en plus de ceux ecrits a la main (defaut 1300, 0 = aucun)
# DEMO_TICKETS=1300
